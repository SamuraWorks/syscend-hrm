APP_NAME=Syscend-HRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Application mode ────────────────────────────────────────────────
# demo | live   (EnsureMode middleware 404s the demo portals when live)
APP_MODE=demo

# ── Licensing ────────────────────────────────────────────────────────
# Generate a key with:  php artisan license:generate "Your Company Ltd" YYYY-MM-DD
LICENSE_ENABLED=false
LICENSE_HOLDER=
LICENSE_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=syscendhrm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── API / CORS / Sanctum ─────────────────────────────────────────────
# Comma-separated list of allowed browser origins for the API.
CORS_ALLOWED_ORIGINS=http://localhost:8001,http://localhost:5173
# Sanctum "stateful" SPA domains (comma-separated, the API's frontend).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8001,localhost:5173
# Bearer token lifetime in minutes (1440 = 24h). Override per client.
SANCTUM_TOKEN_EXPIRATION=1440

# ── Production bootstrap user (ProductionSeeder) ─────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=

# ── Observability ────────────────────────────────────────────────────
TELESCOPE_ENABLED=false
# SENTRY_LARAVEL_DSN=
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/xxx (posts production errors)

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
